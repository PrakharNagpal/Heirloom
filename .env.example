# ---- Pick ONE path ----

# A) Vertex AI with Application Default Credentials (no key in the repo).
#    Auth with `gcloud auth application-default login`, or point
#    GOOGLE_APPLICATION_CREDENTIALS at a service-account JSON file.
GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# B) Gemini API key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# ---- Optional ----
# Comma-separated model fallback chains, tried left to right.
# GEMINI_UNDERSTAND_MODEL=gemini-3.1-pro-preview,gemini-3.7-flash,gemini-2.5-pro
# GEMINI_GENERATE_MODEL=gemini-3.7-flash,gemini-2.5-flash

# Length of public/demo.webm in seconds — lets the test script check timestamp coverage.
# DEMO_DURATION_SEC=
